# ==============================================================================
# Abadikala Fresh Flowers — Environment Variables Template
# ==============================================================================
# 1. Untuk pengembangan lokal: salin file ini menjadi `.env` lalu isi nilainya.
# 2. Untuk produksi Vercel: masukkan variabel di bawah pada
#    Vercel Dashboard -> Project Settings -> Environment Variables
#    (centang Production, Preview, dan Development sesuai kebutuhan).
#
# PERINGATAN KEAMANAN:
# JANGAN PERNAH memasukkan `SUPABASE_SERVICE_ROLE_KEY` atau password database
# ke dalam variabel berawalan `VITE_` (karena semua `VITE_*` ikut terbundel
# ke frontend browser).

# [WAJIB untuk Mode Produksi Supabase]
# URL proyek Supabase (Supabase Dashboard -> Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# [WAJIB untuk Mode Produksi Supabase]
# Anon / Public Key Supabase (aman untuk frontend karena dilindungi PostgreSQL RLS)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# [OPSIONAL — Direkomendasikan untuk SEO]
# URL domain produksi Vercel Anda (tanpa garis miring di akhir)
VITE_SITE_URL=https://abadikala-fresh-flowers.vercel.app
